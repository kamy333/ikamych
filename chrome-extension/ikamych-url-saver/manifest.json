{
  "manifest_version": 3,
  "name": "Ikamych URL Saver",
  "description": "Save the current page or a link to Ikamych saved links.",
  "version": "0.1.0",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "https://www.ikamy.ch/*",
    "https://ikamy.ch/*",
    "http://ikamy.local/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Save to Ikamych"
  },
  "options_page": "options.html"
}
